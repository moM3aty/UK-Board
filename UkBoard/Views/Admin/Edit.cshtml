@model UkBoard.Models.CertificateViewModel

@{
    ViewData["Title"] = "Edit Certificate";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card form-card">
    <h4 class="form-card-title"><i class="fas fa-edit me-2"></i> Edit Certificate: @Model.CertificateId</h4>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImagePath" />

        <div class="form-group">
            <label asp-for="CertificateId" class="form-label"></label>
            <div class="input-wrapper">
                <i class="fas fa-hashtag input-icon"></i>
                <input asp-for="CertificateId" class="form-control" />
            </div>
            <span asp-validation-for="CertificateId" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Current Image</label>
            <div class="current-image-container">
                <img src="~/@Model.ExistingImagePath" alt="Current Certificate" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CertificateImage" class="form-label">Upload New Image (Optional)</label>
            <div class="upload-box admin-upload">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>Click to replace image</span>
                <input asp-for="CertificateImage" type="file" accept="image/*" onchange="previewImage(this)" />
            </div>
            <small class="text-muted">Only upload if you want to replace the existing image.</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Changes</button>
            <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            const box = input.closest('.upload-box');
            const span = box.querySelector('span');
            if (input.files && input.files[0]) {
                box.classList.add('has-file');
                span.innerHTML = '<i class="fas fa-check-circle"></i> ' + input.files[0].name;
            }
        }
    </script>
}