@model UkBoard.Models.StudentRegistration

@{
    ViewData["Title"] = "Registration Document";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ربط ملف الـ CSS الخاص بالطباعة الفاخرة -->
<link rel="stylesheet" href="~/css/print-document.css" />

<!-- شريط التحكم العلوي (لا يظهر في الطباعة) -->
<div class="top-controls-bar no-print" dir="ltr">
    <div class="student-name-header">
        Student: @Model.FullName
    </div>
    
    <div class="controls-actions">
        <div class="btn-group-main">
            <button onclick="window.print()" class="btn-print">
                <i class="fas fa-print me-2"></i> Print / Save PDF
            </button>
            <a asp-action="StudentRegistrations" class="btn-back">
                Back to List
            </a>
        </div>
        <div class="btn-group-docs">
            @if (!string.IsNullOrEmpty(Model.PersonalPhotoPath))
            {
                <a href="~/@Model.PersonalPhotoPath" target="_blank" class="btn-doc"><i class="fas fa-user me-1"></i> Photo</a>
            }
            @if (!string.IsNullOrEmpty(Model.IdentityImagePath))
            {
                <a href="~/@Model.IdentityImagePath" target="_blank" class="btn-doc"><i class="fas fa-id-card me-1"></i> ID Document</a>
            }
            @if (!string.IsNullOrEmpty(Model.QualificationImagePath))
            {
                <a href="~/@Model.QualificationImagePath" target="_blank" class="btn-doc"><i class="fas fa-graduation-cap me-1"></i> Certificate</a>
            }
        </div>
    </div>
</div>

<!-- حاوية المستند -->
<div class="document-wrapper no-print-bg">
    
    <!-- الورقة A4 -->
    <div class="a4-sheet" id="printableArea" dir="ltr">
        
        <!-- الهيدر الملكي (متروك كما هو كما طلبت) -->
        <div class="sheet-header">
            <div class="header-logo">
                <img src="~/images/logo.png" alt="UK Board Logo" />
            </div>
            
            <div class="header-title">
                <h1>THE UK BOARD</h1>
                <p>Excellence in Education & Professional Training</p>
            </div>
            
            <div class="header-ref">
                <div class="ref-text">REFERENCE ID</div>
                <div class="ref-number">#@Model.Id.ToString("D4")</div>
                <div id="qrcode-box"></div>
            </div>
        </div>

        <!-- الخط الذهبي والبادج (متروك كما هو) -->
        <div class="badge-divider-container">
            <div class="gold-line"></div>
            <div class="title-badge">ENROLLMENT APPLICATION FORM</div>
        </div>

        <!-- شبكة الأعمدة الجديدة المطابقة للصورة -->
        <div class="sheet-grid">
            
            <!-- العمود الأيسر: بيانات المتقدم -->
            <div class="col-wrapper">
                <div class="col-heading">APPLICANT PROFILE</div>
                <div class="col-content">
                    
                    <div class="profile-photo">
                        @if(!string.IsNullOrEmpty(Model.PersonalPhotoPath))
                        {
                            <img src="~/@Model.PersonalPhotoPath" alt="Student Photo" />
                        }
                        else
                        {
                            <div class="no-photo">No Photo</div>
                        }
                    </div>

                    <div class="data-row">
                        <div class="data-label">FULL NAME</div>
                        <div class="data-value">@Model.FullName</div>
                    </div>
                    
                    <div class="data-row">
                        <div class="data-label">PHONE NUMBER</div>
                        <div class="data-value">@Model.PhoneNumber</div>
                    </div>
                    
                    <div class="data-row">
                        <div class="data-label">MAJOR</div>
                        <div class="data-value highlight">@Model.Major</div>
                    </div>
                    
                    <div class="data-row border-0">
                        <div class="data-label">REGISTRATION DATE</div>
                        <div class="data-value">@Model.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    
                    <div class="charter-agreed-mark">
                        <i class="fas fa-check me-1"></i> CHARTER AGREED
                    </div>
                </div>
            </div>

            <!-- العمود الأيمن: الشروط والأحكام -->
            <div class="col-wrapper">
                <div class="col-heading">TERMS & CONDITIONS (CHARTER)</div>
                <div class="col-content">
                    
                    <div class="terms-text">
                        <p class="mb-3"><strong>Transparency Charter & Enrollment Regulations</strong></p>
                        
                        <p class="mb-2"><strong>1. Nature of the Program:</strong> The student acknowledges their complete awareness that the chosen educational program is an "Independent Professional Program" issued by a British entity. These programs are designed according to private vocational training standards and do not fall under the framework of UK Higher Education.</p>
                        
                        <p class="mb-2"><strong>2. Legal Titles:</strong> The titles granted (Professional Master, Doctorate, etc.) are professional training titles describing acquired skills. They do not confer an academic scientific degree recognized by government entities subject to local university regulation laws.</p>
                        
                        <p class="mb-2"><strong>3. Documentation:</strong> The Academy ensures the validity of the certificate from the British source. Notarization proves document legality but does not convert the program into an academic track.</p>
                        
                        <p class="mb-2"><strong>4. Student Declaration:</strong> "I declare that I have read and understood the nature of the Independent Professional Program. I agree to enroll knowing it does not grant a degree affiliated with British Higher Education, nor gives rights to claim academic equivalence or syndicate enrollment."</p>
                        
                        <p class="mb-2"><strong>5. Honorary Certificates:</strong> Honorary and honorific certificates are non-academic recognitions. They do not confer employment or academic rights. Such certificates are issued solely as formal acknowledgments of appreciation.</p>
                    </div>

                    <!-- صندوق الإقرار المتقطع -->
                    <div class="dashed-agreement">
                        <h5><i class="fas fa-check-square me-2"></i> I HAVE READ AND AGREED</h5>
                        <p>By submitting the electronic form on <strong>@Model.RegistrationDate.ToString("dd MMM yyyy")</strong>, the student <strong>@Model.FullName</strong> has legally agreed to the terms above.</p>
                    </div>
                    
                </div>
            </div>

        </div>

        <!-- الفوتر -->
        <div class="sheet-footer mt-auto">
            <div>The UK Board - System Report</div>
            <div>CONFIDENTIAL DOCUMENT</div>
            <div>Printed: @DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- QR Code Generator -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var qrText = "Ref: UKB-@DateTime.Now.Year-@Model.Id.ToString("D4")\nName: @Model.FullName\nDate: @Model.RegistrationDate.ToString("yyyy-MM-dd")";
            new QRCode(document.getElementById("qrcode-box"), {
                text: qrText,
                width: 60,
                height: 60,
                colorDark : "#0f172a",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.L
            });
        });
    </script>
}