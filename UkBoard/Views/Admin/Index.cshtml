@model IEnumerable<UkBoard.Models.Certificate>

@{
    ViewData["Title"] = "Certificates Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="table-header">
        <h4 class="table-title"><i class="fas fa-certificate me-2"></i> Certificates List</h4>
        <div class="table-actions">
            <form asp-action="Index" method="get" class="search-form">
                <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" class="search-input" placeholder="Search by Certificate ID...">
                <button type="submit" class="btn-search"><i class="fas fa-search"></i></button>
            </form>
            <a asp-action="Create" class="btn-add-new">
                <i class="fas fa-plus"></i> Add New
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Certificate ID</th>
                    <th>Image Preview</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="ID"><strong>@item.CertificateId</strong></td>
                        <td data-label="Preview">
                            <div class="image-preview-wrapper">
                                <img src="~/@item.ImagePath" alt="Certificate" class="certificate-image-thumb" />
                            </div>
                        </td>
                        <td data-label="Actions" class="actions-cell">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon btn-view" title="Edit"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn-icon btn-delete delete-confirm" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-confirm').forEach(button => {
                button.addEventListener('click', function () {
                    const form = this.closest('form');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This certificate will be permanently deleted!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#b5170c',
                        cancelButtonColor: '#193750',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) form.submit();
                    });
                });
            });
        });
    </script>
}