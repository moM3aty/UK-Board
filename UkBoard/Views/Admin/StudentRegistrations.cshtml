@model IEnumerable<UkBoard.Models.StudentRegistration>

@{
    ViewData["Title"] = "Student Registrations";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="table-header">
        <h4 class="table-title" style="color: #193750; font-weight:700;"><i class="fas fa-users me-2"></i> Registration Applications</h4>
        <form asp-action="StudentRegistrations" method="get" class="search-form">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" class="search-input" placeholder="Search by name, phone or major...">
            <button type="submit" class="btn-search"><i class="fas fa-search"></i></button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Major</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                            No registrations found.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsRead ? "" : "unread-row")" style="@(item.IsRead ? "" : "background-color: #f0f8ff; font-weight: 600;")">
                        <td data-label="Date">@item.RegistrationDate.ToString("dd MMM yyyy")</td>
                        <td data-label="Name">@item.FullName</td>
                        <td data-label="Phone">@item.PhoneNumber</td>
                        <td data-label="Major">@item.Major</td>
                        <td data-label="Status">
                            @if (item.IsRead)
                            {
                                <span class="status-badge bg-read" style="background:#198754; color:#fff; padding:5px 10px; border-radius:20px; font-size:0.8rem;"><i class="fas fa-check-circle"></i> Reviewed</span>
                            }
                            else
                            {
                                <span class="status-badge bg-new" style="background:#ffc107; color:#000; padding:5px 10px; border-radius:20px; font-size:0.8rem;"><i class="fas fa-bell"></i> New</span>
                            }
                        </td>
                        <td data-label="Actions" class="actions-cell">
                            <a asp-action="ViewRegistration" asp-route-id="@item.Id" class="btn btn-primary btn-sm" title="View">
                                <i class="fas fa-eye"></i>
                            </a>
                            <form asp-action="DeleteRegistration" asp-route-id="@item.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-danger btn-sm delete-confirm" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-confirm').forEach(button => {
                button.addEventListener('click', function () {
                    const form = this.closest('form');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This application and its attached files will be permanently deleted!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#b5170c',
                        cancelButtonColor: '#193750',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) form.submit();
                    });
                });
            });
        });
    </script>
}