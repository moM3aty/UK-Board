<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Fonts & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="shortcut icon" href="~/images/logo.png" type="image/x-icon">
</head>
<body>

    <div class="page-overlay" id="page-overlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <img src="~/images/logo.png" class="sidebar-logo" alt="Logo">
        </div>

        <div class="nav-menu-wrapper">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"]?.ToString() == "Certificates Management" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-certificate nav-icon"></i>
                        <span class="nav-text">Certificates</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["Title"]?.ToString() == "Student Registrations" ? "active" : "")" asp-controller="Admin" asp-action="StudentRegistrations">
                        <i class="fa-solid fa-users nav-icon"></i>
                        <span class="nav-text">Registrations</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout-button">
                    <i class="fa-solid fa-right-from-bracket nav-icon"></i>
                    <span class="nav-text">Log Out</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="main-content" id="main-content">
        <header class="topbar">
            <button class="sidebar-toggler" id="sidebar-toggler">
                <i class="fas fa-bars"></i>
            </button>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <div class="admin-welcome">
                <i class="fas fa-user-shield me-2"></i> Welcome, Admin
            </div>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
            document.addEventListener('DOMContentLoaded', function () {
                const sidebar = document.getElementById('sidebar');
                const toggler = document.getElementById('sidebar-toggler');
                const overlay = document.getElementById('page-overlay');

                function toggleSidebar() {
                    sidebar.classList.toggle('active');
                    overlay.classList.toggle('active');
                }

                if (toggler) toggler.addEventListener('click', toggleSidebar);
                if (overlay) overlay.addEventListener('click', toggleSidebar);
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>